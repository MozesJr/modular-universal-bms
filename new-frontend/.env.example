# Base URL of the backend REST API (see ../backend). Include the /api
# suffix — every service call in src/services/*.ts appends its own path
# on top of this (e.g. `${VITE_API_URL}/auth/login`).
VITE_API_URL=http://localhost:3000/api

# No separate socket URL/port needed: Socket.IO is attached to the same
# HTTP server as the REST API (see backend/src/server.js), so
# src/services/socket.ts derives it by stripping the /api suffix off
# VITE_API_URL above.
# Test